{
  "name": "ELYREON workflow validation before API or import",
  "active": false,
  "nodes": [
    {
      "id": "input",
      "name": "Agent Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "validate",
      "name": "Validate workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://elyraon.com.co/agents/check",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $execution.id + \"-\" + $itemIndex }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "ELYREON workflow free token"
        }
      }
    }
  ],
  "connections": {
    "Agent Input": {
      "main": [
        [
          {
            "node": "Validate workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {
    "Agent Input": [
      {
        "json": {
          "workflow": {
            "nodes": [
              {
                "id": "start",
                "name": "Start",
                "type": "n8n-nodes-base.manualTrigger",
                "parameters": {}
              }
            ],
            "connections": {}
          }
        }
      }
    ]
  }
}
